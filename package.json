{
  "name": "rigverse",
  "version": "0.1.0",
  "private": true,
  "description": "RIGVERSE — Build Your World. Piece by Piece. A premium gaming PC and setup configurator.",
  "workspaces": [
    "apps/web",
    "apps/api",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:api": "npm run dev --workspace=apps/api",
    "build": "npm run build:web && npm run build:api",
    "build:web": "npm run build --workspace=apps/web",
    "build:api": "npm run build --workspace=apps/api",
    "start": "npm run start --workspace=apps/web",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspace=apps/web",
    "prisma:generate": "npm run prisma:generate --workspace=apps/api",
    "prisma:migrate": "npm run prisma:migrate --workspace=apps/api",
    "prisma:seed": "npm run prisma:seed --workspace=apps/api",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "db:up": "docker-compose up -d db redis",
    "db:down": "docker-compose down"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
